# --- Qloo (server-side only; never expose to the browser) ---
# Leave empty to run in demo mode with synthetic data.
QLOO_API_KEY=
# Hackathon keys only work against this base URL.
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Optional: force demo data (1) or force live (0). Unset = demo when no key.
QLOO_MOCK=
# Optional: heatmap output boundary (empty = API default geohash grid).
QLOO_HEATMAP_BOUNDARY=

# --- LLM (any OpenAI-compatible endpoint with tool calling) ---
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# --- Public demo safety ---
RATE_LIMIT_PER_HOUR=30
CACHE_PATH=/tmp/opening_act_cache.sqlite
